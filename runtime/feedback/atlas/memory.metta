(= (maxFeedback) (empty))
(= (maxHistory) (empty))
(= (initKnowledge) True)
(= (getPrompt $provider) "Apply persisted clinician feedback using the declared review policy.")
(= (initMemory) (progn (configure maxFeedback 2000) (configure maxHistory 2000)
 (py-call (helper.add_llm_command read-current-feedback))
 (py-call (helper.add_llm_command apply-review-policy))
 (py-call (helper.add_llm_command finish-reviewed-atlas))
 (py-call (bridge.init_memory))))
(= (getHistory) (py-call (bridge.history)))
(= (addToHistory $lastmessage $response $sexpr $msgnew) (py-call (bridge.record_step)))
