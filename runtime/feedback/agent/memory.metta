(= (maxFeedback) (empty))
(= (maxHistory) (empty))
(= (initKnowledge) True)
(= (getPrompt $provider) (py-call (bridge.prompt)))
(= (initMemory) (progn (configure maxFeedback 24000) (configure maxHistory 1000)
 (py-call (helper.add_llm_command finish-review))
 (py-call (bridge.init_memory))))
(= (getHistory) (py-call (bridge.history)))
(= (addToHistory $lastmessage $response $sexpr $msgnew) REVIEW-HISTORY-RECORDED)
