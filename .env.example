# Copy to .env and fill in. Never commit .env.

# LLM
LLM_HOST=
LLM_MODEL=
LLM_API_KEY=
LLM_HOST_2=
LLM_API_KEY_2=

# Qdrant
QDRANT_HOST=
QDRANT_PORT=
PATIENT_COLLECTION=
PC_COLLECTION=

# ALIS backend
ALIS_API_URL=
ALIS_SERVICE_KEY=
ALIS_JWT_SECRET=

# docker-compose
API_PORT=
ALIS_BACKEND_NETWORK=

# Intervention Atlas (optional)
ATLAS_PRECOMPUTE=1
ATLAS_PRECOMPUTE_HOURS=24
ATLAS_PRECOMPUTE_WORKERS=2
ATLAS_STORE_MAX_AGE_DAYS=7
ATLAS_WARMUP=1

# Public APIs (optional, raise rate limits)
NCBI_API_KEY=
OPENFDA_API_KEY=
